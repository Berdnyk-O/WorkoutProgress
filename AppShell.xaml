<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WorkoutProgress.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WorkoutProgress.View"
    Title="WorkoutProgress">

    <TabBar>
        <ShellContent
            Title="Profile"
            ContentTemplate="{DataTemplate local:ProfilePage}"
            Route="ProfilePage" />
       
        <ShellContent
            Title="Training Program"
            ContentTemplate="{DataTemplate local:TrainingProgramPage}"
            Route="TrainingProgramPage" />
        
        <ShellContent
            Title="Add Entry"
            ContentTemplate="{DataTemplate local:AddEntryPage}"
            Route="AddEntryPage" />
        
        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate local:HistoryPage}"
            Route="HistoryPage" />
        
        <ShellContent
            Title="stats"
            ContentTemplate="{DataTemplate local:StatisticsPage}"
            Route="StatisticsPage" />
    </TabBar>


</Shell>
